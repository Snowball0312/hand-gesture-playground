# ---- 大体积素材：不随仓库分发 ----
# 模型 7.5MB，跑 py -3.12 tools/fetch_assets.py 自动下载（含 sha256 校验）；
# 玫瑰帧 19.5MB 需自备视频生成，缺失时「花开」会自动退化为程序化花型。
assets/*.task
projects/flower_bloom/assets/*.npz
*.part
